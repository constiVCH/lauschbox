{
  "expo": {
    "name": "Lauschbox",
    "slug": "lauschbox-testapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.lauschbox.app"
    },
    "android": {
      "package": "de.lauschbox.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B2333",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "scheme": "lauschbox",
    "backgroundColor": "#1B2333",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3dae0cb4-252f-4567-b801-1d7d30da07a2"
      }
    },
    "owner": "constih"
  }
}
